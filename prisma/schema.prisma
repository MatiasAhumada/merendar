generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String?       @unique
  username     String?       @unique
  passwordHash String?
  role         UserRole?
  isActive     Boolean       @default(true)
  sessions     AuthSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum UserRole {
  PRESIDENTE
  SECRETARIA
  TESORERIA
  VOCALIA
  REVISION_CUENTAS
}

model AuthSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model LoginAttempt {
  id           String   @id @default(cuid())
  candidateKey String
  createdAt    DateTime @default(now())

  @@index([candidateKey, createdAt])
  @@index([createdAt])
}
